# ========== 模型网关（AI Gateway）==========
# 必填：OpenAI 兼容协议的模型网关 Key
# 获取方式：EdgeOne Makers 控制台 → 模型与密钥 → 新建 API Key
AI_GATEWAY_API_KEY=your-api-key

# 必填：网关 Base URL。Makers 内置模型固定为下面的地址
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# 可选：模型 ID。默认使用 Makers 内置免费模型
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ========== 高德地图 Web 服务 ==========
# 必填：出行决策 Agent 用它检索商场、门店和距离
# 获取方式：高德开放平台控制台 → 应用管理 → 创建应用 → 添加 Key → 服务平台选择「Web 服务」
AMAP_API_KEY=your-amap-web-service-key
